<Window x:Class="Guf1.AudioPreviewWindow"
        Icon="app.ico"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GUF1 - Anteprima audio"
        Height="560"
        Width="920"
        MinHeight="460"
        MinWidth="720"
        WindowStartupLocation="CenterOwner"
        Background="#F6F7F9"
        Closing="Window_Closing">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,12">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top" Margin="12,0,0,0">
                <Button x:Name="PrevButton"
                        MinWidth="42"
                        Height="32"
                        Padding="8,0"
                        Margin="0,0,4,0"
                        Click="Prev_Click"
                        Content="&lt;&lt;"
                        ToolTip="Registrazione precedente"/>
                <TextBlock x:Name="NavIndexText"
                           VerticalAlignment="Center"
                           Margin="4,0"
                           Foreground="#5B6470"/>
                <Button x:Name="NextButton"
                        MinWidth="42"
                        Height="32"
                        Padding="8,0"
                        Margin="4,0,0,0"
                        Click="Next_Click"
                        Content="&gt;&gt;"
                        ToolTip="Registrazione successiva"/>
            </StackPanel>
            <StackPanel>
                <TextBlock x:Name="TitleText"
                           FontSize="20"
                           FontWeight="SemiBold"
                           Foreground="#20242A"
                           TextTrimming="CharacterEllipsis"/>
                <TextBlock x:Name="DetailsText"
                           Margin="0,4,0,0"
                           Foreground="#5B6470"
                           TextTrimming="CharacterEllipsis"/>
                <TextBlock x:Name="PathText"
                           Margin="0,4,0,0"
                           Foreground="#5B6470"
                           TextTrimming="CharacterEllipsis"/>
                <CheckBox x:Name="ConfirmedCheck"
                          Margin="0,8,0,0"
                          Content="Confermato"
                          FontWeight="SemiBold"
                          IsChecked="{Binding IsConfirmed, Mode=TwoWay}"/>
            </StackPanel>
        </DockPanel>

        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="78"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Grid Grid.Row="0" Grid.Column="0" Margin="0,0,8,0">
                <TextBlock x:Name="YAxisTopText"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Top"
                           Foreground="#303640"/>
                <TextBlock x:Name="YAxisMiddleText"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center"
                           Foreground="#303640"/>
                <TextBlock Text="0 Hz"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Bottom"
                           Foreground="#303640"/>
            </Grid>

            <TextBlock Grid.Row="0"
                       Grid.Column="0"
                       Text="Frequenza"
                       Foreground="#303640"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       RenderTransformOrigin="0.5,0.5">
                <TextBlock.RenderTransform>
                    <RotateTransform Angle="-90"/>
                </TextBlock.RenderTransform>
            </TextBlock>

            <Border Grid.Row="0"
                    Grid.Column="1"
                    Background="Black"
                    BorderBrush="#CBD5E1"
                    BorderThickness="1">
                <Grid>
                    <Image x:Name="SpectrogramImage"
                           Stretch="Fill"
                           RenderOptions.BitmapScalingMode="NearestNeighbor"
                           SnapsToDevicePixels="True"/>
                    <Canvas x:Name="OverlayCanvas"
                            IsHitTestVisible="False">
                        <Line x:Name="PlayheadLine"
                              Y1="0"
                              Stroke="#FF3B30"
                              StrokeThickness="2"
                              Visibility="Collapsed"/>
                    </Canvas>
                    <TextBlock x:Name="LoadingText"
                               Text="Calcolo spettrogramma..."
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               FontWeight="SemiBold"
                               Foreground="White"/>
                </Grid>
            </Border>

            <Grid Grid.Row="1"
                  Grid.Column="1"
                  Margin="0,6,0,0">
                <TextBlock Text="0.00 s"
                           HorizontalAlignment="Left"
                           Foreground="#303640"/>
                <TextBlock x:Name="XAxisEndText"
                           HorizontalAlignment="Right"
                           Foreground="#303640"/>
                <TextBlock Text="Tempo (s)"
                           HorizontalAlignment="Center"
                           Foreground="#303640"/>
            </Grid>
        </Grid>

        <Grid Grid.Row="2" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button x:Name="PlayPauseButton"
                    Grid.Column="0"
                    MinWidth="42"
                    Height="32"
                    Padding="12,0"
                    Margin="0,0,8,0"
                    Click="PlayPause_Click"
                    Content="&#x25B6;"
                    ToolTip="Play/Pausa"
                    IsEnabled="False"/>
            <Button x:Name="StopButton"
                    Grid.Column="1"
                    MinWidth="42"
                    Height="32"
                    Padding="12,0"
                    Margin="0,0,8,0"
                    Click="Stop_Click"
                    Content="&#x25A0;"
                    ToolTip="Stop"
                    IsEnabled="False"/>
            <Button x:Name="ReplayButton"
                    Grid.Column="2"
                    MinWidth="42"
                    Height="32"
                    Padding="12,0"
                    Margin="0,0,12,0"
                    Click="Replay_Click"
                    Content="&#x21BB;"
                    ToolTip="Replay"
                    IsEnabled="False"/>
            <Slider x:Name="PositionSlider"
                    Grid.Column="3"
                    Minimum="0"
                    IsMoveToPointEnabled="True"
                    ValueChanged="PositionSlider_ValueChanged"
                    PreviewMouseDown="PositionSlider_PreviewMouseDown"
                    PreviewMouseUp="PositionSlider_PreviewMouseUp"
                    IsEnabled="False"/>
            <TextBlock x:Name="TimeText"
                       Grid.Column="4"
                       MinWidth="120"
                       Margin="12,0,0,0"
                       VerticalAlignment="Center"
                       TextAlignment="Right"
                       Foreground="#303640"/>
        </Grid>

        <Border Grid.Row="3"
                x:Name="MessagePanel"
                Visibility="Collapsed"
                Margin="0,12,0,0"
                Padding="10"
                Background="#FFF8E8"
                BorderBrush="#E5C168"
                BorderThickness="1"
                CornerRadius="6">
            <TextBlock x:Name="MessageText"
                       TextWrapping="Wrap"
                       Foreground="#624A0B"/>
        </Border>
    </Grid>
</Window>
