<Window x:Class="Guf1.AudioPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Anteprima audio"
        Height="560"
        Width="920"
        MinHeight="460"
        MinWidth="720"
        WindowStartupLocation="CenterOwner"
        Background="#F6F7F9"
        Closing="Window_Closing">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock x:Name="TitleText"
                       FontSize="20"
                       FontWeight="SemiBold"
                       Foreground="#20242A"
                       TextTrimming="CharacterEllipsis"/>
            <TextBlock x:Name="DetailsText"
                       Margin="0,4,0,0"
                       Foreground="#5B6470"
                       TextTrimming="CharacterEllipsis"/>
            <TextBlock x:Name="PathText"
                       Margin="0,4,0,0"
                       Foreground="#5B6470"
                       TextTrimming="CharacterEllipsis"/>
        </StackPanel>

        <Border Grid.Row="1"
                Background="#101820"
                BorderBrush="#CBD5E1"
                BorderThickness="1">
            <Grid>
                <Image x:Name="SpectrogramImage"
                       Stretch="Fill"
                       SnapsToDevicePixels="True"/>
                <Canvas x:Name="OverlayCanvas"
                        IsHitTestVisible="False">
                    <Line x:Name="PlayheadLine"
                          Y1="0"
                          Stroke="#FF3B30"
                          StrokeThickness="2"
                          Visibility="Collapsed"/>
                </Canvas>
                <TextBlock x:Name="LoadingText"
                           Text="Calcolo spettrogramma..."
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           FontWeight="SemiBold"
                           Foreground="White"/>
            </Grid>
        </Border>

        <Grid Grid.Row="2" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button x:Name="PlayPauseButton"
                    Grid.Column="0"
                    MinWidth="82"
                    Height="32"
                    Padding="12,0"
                    Margin="0,0,8,0"
                    Click="PlayPause_Click"
                    Content="Play"
                    IsEnabled="False"/>
            <Button x:Name="StopButton"
                    Grid.Column="1"
                    MinWidth="72"
                    Height="32"
                    Padding="12,0"
                    Margin="0,0,8,0"
                    Click="Stop_Click"
                    Content="Stop"
                    IsEnabled="False"/>
            <Button x:Name="ReplayButton"
                    Grid.Column="2"
                    MinWidth="78"
                    Height="32"
                    Padding="12,0"
                    Margin="0,0,12,0"
                    Click="Replay_Click"
                    Content="Replay"
                    IsEnabled="False"/>
            <Slider x:Name="PositionSlider"
                    Grid.Column="3"
                    Minimum="0"
                    IsMoveToPointEnabled="True"
                    ValueChanged="PositionSlider_ValueChanged"
                    PreviewMouseDown="PositionSlider_PreviewMouseDown"
                    PreviewMouseUp="PositionSlider_PreviewMouseUp"
                    IsEnabled="False"/>
            <TextBlock x:Name="TimeText"
                       Grid.Column="4"
                       MinWidth="120"
                       Margin="12,0,0,0"
                       VerticalAlignment="Center"
                       TextAlignment="Right"
                       Foreground="#303640"/>
        </Grid>

        <Border Grid.Row="3"
                x:Name="MessagePanel"
                Visibility="Collapsed"
                Margin="0,12,0,0"
                Padding="10"
                Background="#FFF8E8"
                BorderBrush="#E5C168"
                BorderThickness="1"
                CornerRadius="6">
            <TextBlock x:Name="MessageText"
                       TextWrapping="Wrap"
                       Foreground="#624A0B"/>
        </Border>
    </Grid>
</Window>
