<Window x:Class="Guf1.MainWindow"
        Icon="app.ico"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Guf1"
        mc:Ignorable="d"
        Title="GUF1" Height="650" Width="1100" MinHeight="520" MinWidth="860"
        Background="#F6F7F9">
    <Window.Resources>
        <!-- Intestazione del giorno: usata sia nella lista sia nell'overlay sticky. -->
        <DataTemplate DataType="{x:Type local:DayGroup}">
            <Border Background="#EAF1F7"
                    BorderBrush="#CAD8E5"
                    BorderThickness="0,0,0,1"
                    Padding="12,8"
                    Margin="0,8,0,4"
                    Cursor="Hand"
                    MouseLeftButtonUp="DayHeader_MouseLeftButtonUp">
                <DockPanel LastChildFill="True">
                    <TextBlock DockPanel.Dock="Right"
                               Margin="18,0,0,0"
                               VerticalAlignment="Center"
                               Foreground="#4D5967"
                               Text="{Binding Count, StringFormat={}{0} righe}"/>
                    <TextBlock VerticalAlignment="Center"
                               FontWeight="SemiBold"
                               Foreground="#1F2933"
                               Text="{Binding Title}"/>
                </DockPanel>
            </Border>
        </DataTemplate>
    </Window.Resources>
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" LastChildFill="True" Margin="0,0,0,14">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button MinWidth="150"
                        Height="36"
                        Padding="14,0"
                        Margin="0,0,8,0"
                        Click="AnalyzeAudio_Click"
                        Content="Analizza audio…"/>
                <Button MinWidth="150"
                        Height="36"
                        Padding="14,0"
                        Click="SelectFolder_Click"
                        Content="Seleziona cartella CSV"/>
            </StackPanel>
            <StackPanel>
                <TextBlock Text="Risultati BirdNET" FontSize="24" FontWeight="SemiBold" Foreground="#20242A"/>
                <TextBlock Text="Carica i CSV validi da una cartella locale e mostra i rilevamenti come card con spettrogramma, divisi per giorno."
                           Margin="0,4,0,0"
                           Foreground="#5B6470"/>
            </StackPanel>
        </DockPanel>

        <Border Grid.Row="1"
                Padding="12"
                Margin="0,0,0,12"
                Background="White"
                BorderBrush="#D9DEE7"
                BorderThickness="1"
                CornerRadius="6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Cartella selezionata" FontWeight="SemiBold" Foreground="#303640"/>
                    <TextBlock x:Name="SelectedFolderText"
                               Text="Nessuna cartella selezionata"
                               Margin="0,3,18,0"
                               TextTrimming="CharacterEllipsis"
                               Foreground="#5B6470"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Margin="18,0,0,0">
                    <TextBlock Text="Righe" FontWeight="SemiBold" Foreground="#303640"/>
                    <TextBlock x:Name="RowsCountText" Text="0" Margin="0,3,0,0" Foreground="#5B6470"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Margin="18,0,0,0">
                    <TextBlock Text="CSV validi" FontWeight="SemiBold" Foreground="#303640"/>
                    <TextBlock x:Name="ValidFilesText" Text="0" Margin="0,3,0,0" Foreground="#5B6470"/>
                </StackPanel>

                <StackPanel Grid.Column="3" Margin="18,0,0,0">
                    <TextBlock Text="Scartati" FontWeight="SemiBold" Foreground="#303640"/>
                    <TextBlock x:Name="InvalidFilesText" Text="0" Margin="0,3,0,0" Foreground="#5B6470"/>
                </StackPanel>

                <StackPanel Grid.Column="4"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="24,0,0,0">
                    <Button x:Name="ExpandAllButton"
                            MinWidth="110"
                            Height="30"
                            Padding="12,0"
                            Margin="0,0,8,0"
                            Click="ExpandAll_Click"
                            Content="Espandi tutto"/>
                    <Button x:Name="CollapseAllButton"
                            MinWidth="110"
                            Height="30"
                            Padding="12,0"
                            Click="CollapseAll_Click"
                            Content="Comprimi tutto"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="2">
            <ListBox x:Name="ResultsList"
                     Background="White"
                     BorderBrush="#D9DEE7"
                     BorderThickness="1"
                     HorizontalContentAlignment="Stretch"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     ScrollViewer.CanContentScroll="True"
                     VirtualizingPanel.IsVirtualizing="True"
                     VirtualizingPanel.VirtualizationMode="Standard"
                     VirtualizingPanel.ScrollUnit="Pixel"
                     SizeChanged="ResultsList_SizeChanged"
                     ScrollViewer.ScrollChanged="ResultsList_ScrollChanged">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="{x:Type ListBoxItem}">
                        <Setter Property="Focusable" Value="False"/>
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="{x:Type ListBoxItem}">
                                    <ContentPresenter/>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.Resources>
                    <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>

                    <Style x:Key="RoundButtonStyle" TargetType="{x:Type Button}">
                        <Setter Property="Foreground" Value="#303640"/>
                        <Setter Property="Background" Value="White"/>
                        <Setter Property="BorderBrush" Value="#6B7684"/>
                        <Setter Property="BorderThickness" Value="1.5"/>
                        <Setter Property="Cursor" Value="Hand"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="{x:Type Button}">
                                    <Grid>
                                        <Ellipse Fill="{TemplateBinding Background}"
                                                 Stroke="{TemplateBinding BorderBrush}"
                                                 StrokeThickness="{TemplateBinding BorderThickness}"/>
                                        <ContentPresenter HorizontalAlignment="Center"
                                                          VerticalAlignment="Center"/>
                                    </Grid>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.8"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>

                    <DataTemplate DataType="{x:Type local:CardRow}">
                        <ItemsControl ItemsSource="{Binding Cards}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="{Binding ColumnCount}"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type local:BirdNetResult}">
                                    <Border Margin="6"
                                            Padding="10"
                                            Background="{Binding DayBackground}"
                                            BorderBrush="#D9DEE7"
                                            BorderThickness="1"
                                            CornerRadius="6"
                                            Loaded="Card_Loaded"
                                            Unloaded="Card_Unloaded">
                                        <StackPanel>
                                            <DockPanel LastChildFill="True">
                                                <TextBlock DockPanel.Dock="Right"
                                                           Margin="8,0,0,0"
                                                           VerticalAlignment="Top"
                                                           FontWeight="SemiBold"
                                                           Foreground="#2D6A4F"
                                                           Text="{Binding Confidence}"
                                                           ToolTip="Confidence"/>
                                                <StackPanel>
                                                    <TextBlock FontWeight="SemiBold"
                                                               FontSize="14"
                                                               Foreground="#1F2933"
                                                               TextTrimming="CharacterEllipsis"
                                                               Text="{Binding CommonName}"
                                                               ToolTip="{Binding CommonName}"/>
                                                    <TextBlock FontStyle="Italic"
                                                               Foreground="#5B6470"
                                                               TextTrimming="CharacterEllipsis"
                                                               Text="{Binding ScientificName}"
                                                               ToolTip="{Binding ScientificName}"/>
                                                </StackPanel>
                                            </DockPanel>

                                            <Border Margin="0,8,0,0"
                                                    Height="110"
                                                    Background="Black"
                                                    BorderBrush="#CBD5E1"
                                                    BorderThickness="1"
                                                    Cursor="Hand"
                                                    ToolTip="Riproduci / ferma"
                                                    MouseLeftButtonUp="Spectrogram_MouseLeftButtonUp">
                                                <Grid>
                                                    <Image Source="{Binding Spectrogram}"
                                                           Stretch="Fill"
                                                           RenderOptions.BitmapScalingMode="Linear"/>
                                                    <TextBlock Text="{Binding SpectrogramStatus}"
                                                               Margin="6"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Top"
                                                               TextWrapping="Wrap"
                                                               TextAlignment="Center"
                                                               FontSize="11"
                                                               Foreground="White"/>
                                                    <Grid IsHitTestVisible="False"
                                                          Visibility="{Binding IsPlaying, Converter={StaticResource BoolToVisibility}}">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="{Binding PlayheadBefore}"/>
                                                            <ColumnDefinition Width="2"/>
                                                            <ColumnDefinition Width="{Binding PlayheadAfter}"/>
                                                        </Grid.ColumnDefinitions>
                                                        <Rectangle Grid.Column="1" Fill="#FF3B30"/>
                                                    </Grid>
                                                    <Button Width="44"
                                                            Height="44"
                                                            Style="{StaticResource RoundButtonStyle}"
                                                            Background="#99000000"
                                                            BorderBrush="White"
                                                            Foreground="White"
                                                            HorizontalAlignment="Center"
                                                            VerticalAlignment="Center"
                                                            Click="PlayCard_Click"
                                                            ToolTip="Riproduci / ferma">
                                                        <TextBlock Text="{Binding PlayGlyph}"
                                                                   FontSize="16"
                                                                   Margin="2,0,0,0"/>
                                                    </Button>
                                                </Grid>
                                            </Border>

                                            <DockPanel Margin="0,8,0,0" LastChildFill="True">
                                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                                    <Button Width="28"
                                                            Height="24"
                                                            Padding="0"
                                                            Margin="0,0,6,0"
                                                            Click="AudioFileLink_Click"
                                                            ToolTip="{Binding AudioFile}">
                                                        <Viewbox Width="13" Height="13">
                                                            <Path Fill="#303640"
                                                                  Data="M3,1 L9,1 L13,5 L13,15 L3,15 Z M9,1 L9,5 L13,5 M5,8 L11,8 M5,11 L11,11"/>
                                                        </Viewbox>
                                                    </Button>
                                                    <Button Width="24"
                                                            Height="24"
                                                            Style="{StaticResource RoundButtonStyle}"
                                                            Click="AudioPreview_Click"
                                                            ToolTip="Apri dettagli">
                                                        <TextBlock Text="i"
                                                                   FontFamily="Georgia"
                                                                   FontWeight="Bold"
                                                                   FontStyle="Italic"
                                                                   FontSize="14"
                                                                   Margin="0,-1,0,0"/>
                                                    </Button>
                                                </StackPanel>
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock FontWeight="SemiBold"
                                                               Foreground="#1F2933"
                                                               Text="{Binding RecordingTime}"
                                                               ToolTip="Ora della registrazione"/>
                                                    <TextBlock Foreground="#303640"
                                                               Text="{Binding TimeRange}"/>
                                                    <TextBlock Foreground="#7A8491"
                                                               FontSize="11"
                                                               TextTrimming="CharacterEllipsis"
                                                               Text="{Binding SourceCsv}"
                                                               ToolTip="{Binding SourceCsv}"/>
                                                </StackPanel>
                                            </DockPanel>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </DataTemplate>
                </ListBox.Resources>
            </ListBox>

            <!-- Intestazione sticky: ripete il giorno corrente in alto; il margine destro lascia libera la scrollbar. -->
            <Border x:Name="StickyHeaderHost"
                    Visibility="Collapsed"
                    VerticalAlignment="Top"
                    Background="White"
                    Margin="1,1,18,0">
                <ContentControl x:Name="StickyHeader"/>
            </Border>

            <Border x:Name="LoadingOverlay"
                    Visibility="Collapsed"
                    Background="#CCFFFFFF"
                    BorderBrush="#D9DEE7"
                    BorderThickness="1">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <ProgressBar Width="260"
                                 Height="8"
                                 IsIndeterminate="True"/>
                    <TextBlock Text="Caricamento file CSV..."
                               Margin="0,14,0,0"
                               HorizontalAlignment="Center"
                               FontWeight="SemiBold"
                               Foreground="#303640"/>
                </StackPanel>
            </Border>
        </Grid>

        <Border Grid.Row="3"
                x:Name="MessagePanel"
                Visibility="Collapsed"
                Margin="0,12,0,0"
                Padding="12"
                Background="#FFF8E8"
                BorderBrush="#E5C168"
                BorderThickness="1"
                CornerRadius="6">
            <TextBlock x:Name="MessageText"
                       TextWrapping="Wrap"
                       Foreground="#624A0B"/>
        </Border>
    </Grid>
</Window>
