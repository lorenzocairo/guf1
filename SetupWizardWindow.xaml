<Window x:Class="Guf1.SetupWizardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GUF1 — Primo avvio"
        Width="520" Height="420"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="#F6F7F9"
        Closing="Window_Closing">

    <Grid Margin="32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock Grid.Row="0"
                   Text="Installazione componenti"
                   FontSize="22" FontWeight="SemiBold" Foreground="#20242A"/>
        <TextBlock Grid.Row="1"
                   Margin="0,6,0,16"
                   TextWrapping="Wrap"
                   Foreground="#5B6470">
            GUF1 sta scaricando Python e BirdNET-Analyzer.
            Questa operazione richiede alcuni minuti e avviene una sola volta.
        </TextBlock>

        <!-- Log -->
        <Border Grid.Row="2"
                Background="#1E2228" CornerRadius="4" Padding="10">
            <ScrollViewer x:Name="LogScroll" VerticalScrollBarVisibility="Auto">
                <TextBox x:Name="LogBox"
                         Background="Transparent"
                         Foreground="#A8B4C0"
                         FontFamily="Consolas"
                         FontSize="11"
                         IsReadOnly="True"
                         BorderThickness="0"
                         TextWrapping="Wrap"
                         AcceptsReturn="True"
                         VerticalScrollBarVisibility="Disabled"/>
            </ScrollViewer>
        </Border>

        <!-- Step label -->
        <TextBlock Grid.Row="3"
                   x:Name="StepLabel"
                   Margin="0,12,0,4"
                   FontSize="12"
                   Foreground="#303640"
                   Text="Avvio…"/>

        <!-- Progress bar -->
        <ProgressBar Grid.Row="4"
                     x:Name="ProgressBar"
                     Height="8"
                     Minimum="0" Maximum="100" Value="0"/>

        <!-- Bottom buttons -->
        <DockPanel Grid.Row="5" LastChildFill="False" Margin="0,16,0,0">
            <Button x:Name="CancelButton"
                    DockPanel.Dock="Left"
                    Content="Annulla"
                    Height="34" Padding="16,0"
                    Click="Cancel_Click"/>
            <Button x:Name="ContinueButton"
                    DockPanel.Dock="Right"
                    Content="Continua →"
                    Height="34" Padding="16,0"
                    IsEnabled="False"
                    Click="Continue_Click"/>
        </DockPanel>
    </Grid>
</Window>
