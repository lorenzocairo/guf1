<Window x:Class="Guf1.AnalyzeWindow"
        Icon="app.ico"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Analizza audio con BirdNET"
        Width="680" Height="700"
        MinWidth="560" MinHeight="560"
        WindowStartupLocation="CenterOwner"
        Background="#F6F7F9">

    <Window.Resources>
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#303640"/>
            <Setter Property="Margin" Value="0,16,0,6"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#5B6470"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>
        <Style TargetType="Slider">
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- title -->
            <RowDefinition Height="*"/>      <!-- scroll content -->
            <RowDefinition Height="Auto"/>   <!-- log -->
            <RowDefinition Height="Auto"/>   <!-- progress -->
            <RowDefinition Height="Auto"/>   <!-- buttons -->
        </Grid.RowDefinitions>

        <!-- Title -->
        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="Analisi BirdNET" FontSize="22" FontWeight="SemiBold" Foreground="#20242A"/>
            <TextBlock Text="Configura i parametri e avvia l'analisi degli audio."
                       Margin="0,4,0,0" Foreground="#5B6470"/>
        </StackPanel>

        <!-- Scrollable settings -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <!-- Paths -->
                <Border Background="White" BorderBrush="#D9DEE7" BorderThickness="1" CornerRadius="6" Padding="14">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionHeader}" Margin="0,0,0,6">Cartelle</TextBlock>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource Label}" Text="Audio input"/>
                            <TextBox Grid.Column="1" x:Name="InputFolderBox" IsReadOnly="True"
                                     Background="#F3F5F8" Padding="6,4" VerticalContentAlignment="Center"/>
                            <Button Grid.Column="2" Content="Sfoglia…" Margin="6,0,0,0"
                                    Height="28" Padding="10,0" Click="BrowseInput_Click"/>
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource Label}" Text="Output CSV"/>
                            <TextBox Grid.Column="1" x:Name="OutputFolderBox" IsReadOnly="True"
                                     Background="#F3F5F8" Padding="6,4" VerticalContentAlignment="Center"/>
                            <Button Grid.Column="2" Content="Sfoglia…" Margin="6,0,0,0"
                                    Height="28" Padding="10,0" Click="BrowseOutput_Click"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Detection -->
                <Border Background="White" BorderBrush="#D9DEE7" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,10,0,0">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionHeader}">Rilevamento</TextBlock>

                        <!-- Min confidence -->
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="50"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource Label}" Text="Confidenza minima"/>
                            <Slider Grid.Column="1" x:Name="MinConfSlider"
                                    Minimum="0.01" Maximum="0.99" Value="0.1"
                                    SmallChange="0.01" LargeChange="0.1" TickFrequency="0.01"
                                    ValueChanged="MinConfSlider_ValueChanged"/>
                            <TextBlock Grid.Column="2" x:Name="MinConfLabel"
                                       HorizontalAlignment="Right" VerticalAlignment="Center" Text="0.10"/>
                        </Grid>

                        <!-- Sensitivity -->
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="50"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource Label}" Text="Sensitivity"/>
                            <Slider Grid.Column="1" x:Name="SensitivitySlider"
                                    Minimum="0.5" Maximum="1.5" Value="1.0"
                                    SmallChange="0.05" LargeChange="0.1"
                                    ValueChanged="SensitivitySlider_ValueChanged"/>
                            <TextBlock Grid.Column="2" x:Name="SensitivityLabel"
                                       HorizontalAlignment="Right" VerticalAlignment="Center" Text="1.00"/>
                        </Grid>

                        <!-- Overlap -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="50"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource Label}" Text="Overlap (s)"/>
                            <Slider Grid.Column="1" x:Name="OverlapSlider"
                                    Minimum="0.0" Maximum="2.9" Value="0.0"
                                    SmallChange="0.1" LargeChange="0.5"
                                    ValueChanged="OverlapSlider_ValueChanged"/>
                            <TextBlock Grid.Column="2" x:Name="OverlapLabel"
                                       HorizontalAlignment="Right" VerticalAlignment="Center" Text="0.0"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Location filter -->
                <Border Background="White" BorderBrush="#D9DEE7" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,10,0,0">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionHeader}">Filtro per posizione (opzionale)</TextBlock>
                        <TextBlock Foreground="#5B6470" FontSize="11" Margin="0,0,0,8" TextWrapping="Wrap">
                            Lascia vuoto per disabilitare. Con lat/lon BirdNET filtra le specie presenti nella tua zona.
                        </TextBlock>

                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="120"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource Label}" Text="Latitudine"/>
                            <TextBox Grid.Column="1" x:Name="LatBox" Padding="6,4"
                                     VerticalContentAlignment="Center" TextChanged="LatBox_TextChanged"/>
                            <TextBlock Grid.Column="3" Style="{StaticResource Label}" Text="Longitudine"/>
                            <TextBox Grid.Column="4" x:Name="LonBox" Padding="6,4"
                                     VerticalContentAlignment="Center" TextChanged="LonBox_TextChanged"/>
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource Label}" Text="Settimana"/>
                            <ComboBox Grid.Column="1" x:Name="WeekCombo" Padding="6,4"
                                      SelectedIndex="0"/>
                            <TextBlock Grid.Column="2" Foreground="#5B6470" FontSize="11" Margin="10,0,0,0"
                                       VerticalAlignment="Center" Text="(-1 = auto da data sistema)"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Species list filter -->
                <Border Background="White" BorderBrush="#D9DEE7" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,10,0,0">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionHeader}">Lista specie personalizzata (opzionale)</TextBlock>
                        <TextBlock Foreground="#5B6470" FontSize="11" Margin="0,0,0,8" TextWrapping="Wrap">
                            File .txt con una specie per riga nel formato "Nome comune_Nome scientifico".
                            Se specificato, BirdNET rileva solo queste specie.
                        </TextBlock>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" x:Name="SpeciesListBox" IsReadOnly="True"
                                     Background="#F3F5F8" Padding="6,4" VerticalContentAlignment="Center"/>
                            <Button Grid.Column="1" Content="Sfoglia…" Margin="6,0,0,0"
                                    Height="28" Padding="10,0" Click="BrowseSpeciesList_Click"/>
                            <Button Grid.Column="2" Content="✕" Margin="4,0,0,0"
                                    Height="28" Width="28" Padding="0"
                                    ToolTip="Rimuovi lista" Click="ClearSpeciesList_Click"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Performance & output -->
                <Border Background="White" BorderBrush="#D9DEE7" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,10,0,0">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionHeader}">Prestazioni e output</TextBlock>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="40"/>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="80"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource Label}" Text="Thread CPU"/>
                            <Slider Grid.Column="1" x:Name="ThreadsSlider"
                                    Minimum="1" Maximum="32" Value="4" IsSnapToTickEnabled="True" TickFrequency="1"
                                    ValueChanged="ThreadsSlider_ValueChanged"/>
                            <TextBlock Grid.Column="2" x:Name="ThreadsLabel"
                                       VerticalAlignment="Center" HorizontalAlignment="Center" Text="4"/>
                            <TextBlock Grid.Column="3" Style="{StaticResource Label}" Text="Batch size" Margin="12,0,8,0"/>
                            <Slider Grid.Column="4" x:Name="BatchSlider"
                                    Minimum="1" Maximum="32" Value="1" IsSnapToTickEnabled="True" TickFrequency="1"
                                    ValueChanged="BatchSlider_ValueChanged"/>
                        </Grid>
                        <TextBlock x:Name="BatchLabel" Foreground="#5B6470" FontSize="11" Margin="0,0,0,8" Text="Batch: 1"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="40"/>
                                <ColumnDefinition Width="60"/>
                                <ColumnDefinition Width="120"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource Label}" Text="Locale"/>
                            <ComboBox Grid.Column="1" x:Name="LocaleCombo" Padding="4,2" SelectedIndex="0">
                                <ComboBoxItem Content="en" Tag="en"/>
                                <ComboBoxItem Content="it" Tag="it"/>
                                <ComboBoxItem Content="de" Tag="de"/>
                                <ComboBoxItem Content="fr" Tag="fr"/>
                                <ComboBoxItem Content="es" Tag="es"/>
                                <ComboBoxItem Content="pt" Tag="pt"/>
                                <ComboBoxItem Content="ru" Tag="ru"/>
                                <ComboBoxItem Content="zh" Tag="zh"/>
                            </ComboBox>
                        </Grid>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- Log output -->
        <Border Grid.Row="2" Margin="0,10,0,0"
                Background="#1E2228" CornerRadius="4" Padding="8" Height="120">
            <ScrollViewer x:Name="LogScroll" VerticalScrollBarVisibility="Auto">
                <TextBox x:Name="LogBox"
                         Background="Transparent"
                         Foreground="#A8B4C0"
                         FontFamily="Consolas"
                         FontSize="11"
                         IsReadOnly="True"
                         BorderThickness="0"
                         TextWrapping="Wrap"
                         AcceptsReturn="True"
                         VerticalScrollBarVisibility="Disabled"/>
            </ScrollViewer>
        </Border>

        <!-- Progress bar -->
        <ProgressBar Grid.Row="3" x:Name="ProgressBar"
                     Height="6" Margin="0,8,0,0"
                     Minimum="0" Maximum="100" Value="0"
                     Visibility="Collapsed"/>

        <!-- Buttons -->
        <DockPanel Grid.Row="4" LastChildFill="False" Margin="0,12,0,0">
            <TextBlock x:Name="EnvStatusText"
                       DockPanel.Dock="Left"
                       VerticalAlignment="Center"
                       FontSize="11"
                       Foreground="#5B6470"
                       Text="Ambiente non rilevato"/>
            <Button x:Name="RunButton"
                    DockPanel.Dock="Right"
                    Content="Avvia analisi"
                    Height="36" Padding="18,0"
                    IsEnabled="False"
                    Click="Run_Click"/>
        </DockPanel>
    </Grid>
</Window>
